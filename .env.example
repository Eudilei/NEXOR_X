# ============================================================
# NEXOR X — CREDENCIAIS E CONFIGURAÇÕES EXTERNAS
# ============================================================
# Copie este arquivo para .env somente no ambiente onde o NEXOR rodará.
# NUNCA envie o arquivo .env real para o GitHub.
#
# BINANCE
# Use chaves separadas para TESTNET e LIVE.
# Enquanto LIVE estiver bloqueado, prefira credenciais TESTNET.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Binance Futures
BINANCE_USE_TESTNET=true
BINANCE_LIVE_BASE_URL=https://fapi.binance.com
BINANCE_TESTNET_BASE_URL=https://testnet.binancefuture.com
BINANCE_LIVE_TIMEOUT_SECONDS=10.0
BINANCE_RECV_WINDOW_MS=5000
BINANCE_MAXIMUM_TIME_DRIFT_MS=1000

# TELEGRAM
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# NEXOR X
NEXOR_MODE=PAPER

# Painel / API administrativa
# Defina um token forte e mantenha-o fora do GitHub.
NEXOR_ADMIN_TOKEN=

# Ollama / IA local
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
